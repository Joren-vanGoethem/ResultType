<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\JV.ResultUtilities\JV.ResultUtilities.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Translations\Translations.en.resx">
        <LastGenOutput>Translations.en.Designer.cs</LastGenOutput>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Update="Translations\Translations.nl.resx">
        <LastGenOutput>Translations.nl.Designer.cs</LastGenOutput>
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Translations\Translations.en.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Translations.en.resx</DependentUpon>
      </Compile>
      <Compile Update="Translations\Translations.nl.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Translations.nl.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
